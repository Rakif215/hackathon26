# Exasol Personal (local deployment) — copy to .env and fill in.
# Get these from:  exasol info
# The password is generated per-deployment and lives in:
#   ~/.exasol/personal/deployments/default/secrets.json  (key: dbPassword)
# Leave EXASOL_PASSWORD unset to have the app read secrets.json automatically.
EXASOL_HOST=127.0.0.1
EXASOL_PORT=8563
EXASOL_USER=sys
EXASOL_PASSWORD=
EXASOL_SCHEMA=MEDGUARD
# Remote / AWS deployment: point at the launcher's deployment directory (host, port and password are read
# from its deployment.json and secrets.json) and pin the TLS certificate. The fingerprint is in
# <deployment dir>/connection-instructions.txt. Leave both unset for the local deployment.
# EXASOL_DEPLOYMENT_DIR=/path/to/exasol-aws
# EXASOL_CERT_FINGERPRINT=

# AWS sandbox (Workshop Studio, temporary credentials). bedrock.py uses ONLY these settings and
# ignores the shell's AWS_* variables, which may point at unrelated accounts or blocked regions.
# Region must be us-west-2 (Oregon) or eu-west-1 (Ireland) per the event rules; others are refused.
SANDBOX_AWS_PROFILE=hackathon
SANDBOX_AWS_REGION=us-west-2
# Checked by scripts/preflight.py so nothing runs against the wrong account.
SANDBOX_AWS_ACCOUNT_ID=
# Leave unset to use ~/.aws/config and ~/.aws/credentials.
# SANDBOX_AWS_CONFIG_FILE=/path/to/aws/config
# SANDBOX_AWS_CREDENTIALS_FILE=/path/to/aws/credentials
# Bedrock Guardrail created by scripts/create_guardrail.py (id and version it prints).
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Inference-profile ids (the "us." prefix is required). Verified ACTIVE in us-west-2:
#   us.anthropic.claude-opus-5-5     strongest
#   us.anthropic.claude-sonnet-5-5   default, good balance
#   us.anthropic.claude-haiku-5-5    fastest/cheapest
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
